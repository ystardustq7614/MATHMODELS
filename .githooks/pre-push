#!/bin/sh

set -u

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

check_tip() {
    tip=$1
    if git rev-parse "$tip^1" >/dev/null 2>&1; then
        changed=$(git diff --name-only "$tip^1" "$tip")
    else
        changed=$(git ls-tree -r --name-only "$tip")
    fi
    echo "$changed" | grep -qx 'CHANGELOG.md' || {
        echo "pre-push: tip $tip must modify CHANGELOG.md" >&2
        return 1
    }
    echo "$changed" | grep -qx 'docs/HANDOFF.md' || {
        echo "pre-push: tip $tip must modify docs/HANDOFF.md" >&2
        return 1
    }
    git cat-file -e "$tip:docs/HANDOFF.md" 2>/dev/null || {
        echo "pre-push: tip $tip does not contain docs/HANDOFF.md" >&2
        return 1
    }
    for section in "当前目标" "本次变更" "工作流状态" "验证结果" "已知问题" "下一步" "关键文件/技能建议"; do
        git show "$tip:docs/HANDOFF.md" | grep -Fqx "## $section" || {
            echo "pre-push: docs/HANDOFF.md is missing a required section" >&2
            return 1
        }
    done
    git show "$tip:docs/HANDOFF.md" | grep -Eiq 'TODO|TBD|待填写' && {
        echo "pre-push: docs/HANDOFF.md contains a placeholder" >&2
        return 1
    }
    return 0
}

while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_ref" in
        refs/heads/*)
            case "$local_oid" in
                0000000000000000000000000000000000000000) continue ;;
            esac
            check_tip "$local_oid" || exit 1
            ;;
    esac
done

exit 0
